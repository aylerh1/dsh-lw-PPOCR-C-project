{
  "name": "dsh-lw-PPOCR-C-project",
  "version": "1.0.0",
  "description": "DeepSeek Harness (dsh) lightweight OCR plugin based on lw.PPOCR.C with zero Python/OpenCV/ONNX runtime dependencies",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aylerh1/dsh-lw-PPOCR-C-project.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ocr",
    "ppocr",
    "lw.PPOCR.C",
    "webassembly"
  ],
  "author": "aylerh",
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "category": "tool",
    "capabilities": [
      "ocr",
      "text-recognition",
      "image-analysis"
    ],
    "service": "ocr",
    "locales": [
      "zh-CN",
      "en-US"
    ],
    "description": "基于 lw.PPOCR.C 的轻量级纯 C/WASM 离线 OCR 插件"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/test-plugin.js",
    "test:cli": "node test/test-cli.js",
    "test:server": "node test/test-server.js",
    "test:live": "node test/test-live-server.js"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
